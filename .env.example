# Copie para .env.local na Vercel (Project Settings → Environment Variables)
# Nunca commite chaves reais.

SUPABASE_URL=https://SEU_PROJETO.supabase.co
# Alternativa aceita pela API: URL_SUPABASE
URL_SUPABASE=
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key

# Opcional — sincroniza o lead com a lista do Brevo (e-mail marketing)
BREVO_API_KEY=
BREVO_LIST_ID=
